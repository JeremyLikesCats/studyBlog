---
// src/content/docs/components/StudyGraph.astro
import { getCollection } from 'astro:content';
import StudyHeatmap from './StudyHeatmap';

// 1. Fetch all docs from your content collection
const docs = await getCollection('docs');

// 2. Sum up total study hours for each date (YYYY-MM-DD)
const hoursByDate = new Map<string, number>();

for (const doc of docs) {
	const { hours, studiedOn } = doc.data;
	if (!hours || !studiedOn) continue;

	// Format date to "YYYY-MM-DD"
	const dateStr = studiedOn.toISOString().slice(0, 10);
	hoursByDate.set(dateStr, (hoursByDate.get(dateStr) ?? 0) + hours);
}

// 3. Build a full 365-day array for GitHub-style layout
const today = new Date();
const start = new Date(today);
start.setDate(today.getDate() - 364);

const calendarData: Array<{ date: string; count: number; level: 0 | 1 | 2 | 3 | 4 }> = [];

for (let d = new Date(start); d <= today; d.setDate(d.getDate() + 1)) {
	const dateStr = d.toISOString().slice(0, 10);
	const hours = hoursByDate.get(dateStr) ?? 0;

	// Assign intensity levels (0 to 4) based on hours
	let level: 0 | 1 | 2 | 3 | 4 = 0;
	if (hours > 0 && hours < 1) level = 1;
	else if (hours >= 1 && hours < 2) level = 2;
	else if (hours >= 2 && hours < 4) level = 3;
	else if (hours >= 4) level = 4;

	calendarData.push({
		date: dateStr,
		count: hours,
		level,
	});
}
---

<!-- Render your React component with client:load so it hydrates in the browser -->
<div class="not-content my-6">
	<StudyHeatmap client:load data={calendarData} />
</div>