---
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { hours } = Astro.locals.starlightRoute.entry.data;
const { body, data } = Astro.locals.starlightRoute.entry
const words = body
  ? body.trim().split(/\s+/).filter(Boolean).length
  : 0;
    
---

<div class="title-with-hours">
	<Default />
    <div class="stats">
        {hours != null && (
            <span class="tag">{hours}h studied</span>
        )}
        {body != null && (
            <span class="tag">{body.trim().split(/\s+/).filter(Boolean).length} word{words === 1 ? "": "s"}</span>
        )}
    </div>

</div>

<style>
	.title-with-hours {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem 1rem;
        flex-direction: column;
	}

	.tag {
		color: var(--sl-color-gray-2);
	}

    .stats {
        display: flex;
        gap: 0.75rem 1rem;
    }
</style>